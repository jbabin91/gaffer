{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)"
  ],
  "automerge": true,
  "branchPrefix": "chore/deps-",
  "platformAutomerge": true,
  "rangeStrategy": "bump",
  "schedule": ["before 6am on the first day of the month"],
  "timezone": "America/Chicago",
  "labels": ["dependencies"],
  "packageRules": [
    { "matchUpdateTypes": ["major"], "automerge": false },
    {
      "groupName": "react",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "automerge": false
    },
    {
      "groupName": "tanstack",
      "matchPackageNames": ["@tanstack/*"],
      "automerge": false
    },
    {
      "matchPackageNames": [
        "react-aria-components",
        "tailwindcss-react-aria-components",
        "drizzle-orm",
        "pg"
      ],
      "automerge": false
    },
    {
      "groupName": "tailwindcss",
      "matchPackageNames": [
        "tailwindcss",
        "@tailwindcss/vite",
        "@tailwindcss/typography",
        "tw-animate-css"
      ]
    },
    {
      "groupName": "oxlint",
      "matchPackageNames": ["oxlint", "eslint-plugin-oxlint", "oxlint-tsgolint"]
    },
    { "matchDepTypes": ["peerDependencies"], "rangeStrategy": "widen" }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "schedule": ["at any time"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"],
    "labels": ["lockfile"]
  }
}
