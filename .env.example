# Server database. drizzle-kit (db:migrate, db:push) and the app both read this.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fc2026

# Better Auth. Secret signs sessions/tokens; generate a unique 32-byte value
# per deployment with `openssl rand -base64 32`. URL is the app's public origin,
# used to build links in verification/reset emails.
BETTER_AUTH_SECRET=changeme-generate-a-32-byte-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Bootstrap admin. On a fresh database only this email may sign up (and it becomes
# admin); every other signup needs an invite. Required to create the first admin;
# ignored once an admin exists. Set it to your email before the first signup.
# INITIAL_ADMIN_EMAIL=you@example.com

# Email transport (all optional). Unset: dev logs verification/reset links to
# the terminal; prod errors instead of sending. To send for real, set EMAIL_FROM
# plus CF_EMAIL_TOKEN (Cloudflare) or SMTP_URL (any provider); SMTP_URL wins.
# CF_EMAIL_TOKEN is a secret — never commit it (.env.local in dev, a deploy secret in prod).
# EMAIL_FROM=noreply@example.com
# CF_EMAIL_TOKEN=
# SMTP_URL=smtp://user:pass@mail.smtp2go.com:587

# Logger verbosity (pino). Optional; defaults to debug in dev, info in prod.
# One of: fatal, error, warn, info, debug, trace, silent.
# LOG_LEVEL sets the server level; VITE_LOG_LEVEL sets the browser level (the
# browser has no process.env, so the client logger reads import.meta.env).
# LOG_LEVEL=info
# VITE_LOG_LEVEL=info

# Sentry error tracking. Optional; unset = disabled (dev uses the pino console).
# Only active in production builds. A DSN isn't secret — set VITE_SENTRY_DSN once
# and the server reuses it; SENTRY_DSN only overrides (e.g. a separate project).
# VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# Trace sample rate 0..1 (defaults to 0.1 in prod, 1 in dev).
# SENTRY_TRACES_SAMPLE_RATE=0.1
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# Build-time source-map upload (CI only; unset = no upload). Not app runtime config.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Local dev Postgres (compose.dev.yaml via `pnpm db:dev:up`). All optional;
# compose falls back to these values. Override here to change the container's
# credentials/port; keep them in sync with DATABASE_URL above.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=fc2026
# POSTGRES_PORT=5432
