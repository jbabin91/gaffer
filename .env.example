# Server database. drizzle-kit (db:migrate, db:push) and the app both read this.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fc2026

# Better Auth. Secret signs sessions/tokens; generate a unique 32-byte value
# per deployment with `openssl rand -base64 32`. URL is the app's public origin,
# used to build links in verification/reset emails.
BETTER_AUTH_SECRET=changeme-generate-a-32-byte-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Logger verbosity (pino). Optional; defaults to debug in dev, info in prod.
# One of: fatal, error, warn, info, debug, trace, silent.
# LOG_LEVEL=info

# Local dev Postgres (compose.dev.yaml via `pnpm db:dev:up`). All optional;
# compose falls back to these values. Override here to change the container's
# credentials/port; keep them in sync with DATABASE_URL above.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=fc2026
# POSTGRES_PORT=5432
